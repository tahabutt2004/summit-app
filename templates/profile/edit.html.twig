{% extends 'base.html.twig' %}

{% block title %}Edit Profile | ISM DATA SCIENCE SUMMIT{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="talwar-card">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 mb-4">
            <div>
                <p class="eyebrow mb-2">Summit Member Area</p>
                <h1 class="page-title mb-3">Edit Profile</h1>
                <p class="lead-text mb-0">Update the details connected to your ISM DATA SCIENCE SUMMIT account.</p>
            </div>
            <div class="d-flex flex-wrap align-content-start gap-2">
                <a href="{{ path('app_profile') }}" class="btn btn-ghost">Profile</a>
                <a href="{{ path('app_logout') }}" class="btn btn-ember">Logout</a>
            </div>
        </div>

        {{ form_start(profileForm, {'attr': {'class': 'row g-3'}}) }}
            <div class="col-md-6">
                {{ form_row(profileForm.firstName) }}
            </div>
            <div class="col-md-6">
                {{ form_row(profileForm.lastName) }}
            </div>
            <div class="col-md-6">
                {{ form_row(profileForm.title) }}
            </div>
            <div class="col-md-6">
                {{ form_row(profileForm.mealPreference) }}
            </div>
            <div class="col-12">
                {{ form_row(profileForm.address) }}
            </div>
            <div class="col-12">
                {{ form_row(profileForm.interests) }}
            </div>
            <div class="col-md-6">
                {{ form_row(profileForm.newsletterConsent) }}
            </div>
            <div class="col-md-6">
                {{ form_row(profileForm.dataProtectionConsent) }}
            </div>

            <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-forge btn-lg" type="submit">Save Profile</button>
                <a href="{{ path('app_profile') }}" class="btn btn-ghost btn-lg">Cancel</a>
            </div>
        {{ form_end(profileForm) }}
    </section>
</main>
{% endblock %}
