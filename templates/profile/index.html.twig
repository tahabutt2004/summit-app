{% extends 'base.html.twig' %}

{% block title %}My Profile | ISM DATA SCIENCE SUMMIT{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="talwar-card">
        {% if app.user %}
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 mb-4">
                <div>
                    <p class="eyebrow mb-2">Summit Member Area</p>
                    <h1 class="page-title mb-3">My Profile</h1>
                    <p class="lead-text mb-0">Review and maintain your ISM DATA SCIENCE SUMMIT attendee information.</p>
                </div>
                <div class="d-flex flex-wrap align-content-start gap-2">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-forge">Edit Profile</a>
                    <a href="{{ path('app_logout') }}" class="btn btn-ember">Logout</a>
                </div>
            </div>

            <div class="profile-grid">
                <div class="profile-field">
                    <div class="profile-label">Email</div>
                    <p class="profile-value">{{ app.user.email }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">First Name</div>
                    <p class="profile-value">{{ app.user.firstName|default('') ?: 'Not provided' }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">Last Name</div>
                    <p class="profile-value">{{ app.user.lastName|default('') ?: 'Not provided' }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">Title</div>
                    <p class="profile-value">{{ app.user.title|default('') ?: 'Not provided' }}</p>
                </div>
                <div class="profile-field full">
                    <div class="profile-label">Address</div>
                    <p class="profile-value">{{ app.user.address|default('') ? app.user.address|nl2br : 'Not provided' }}</p>
                </div>
                <div class="profile-field full">
                    <div class="profile-label">Interests</div>
                    <p class="profile-value">{{ app.user.interests|default('') ? app.user.interests|nl2br : 'Not provided' }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">Meal Preference</div>
                    <p class="profile-value">{{ app.user.mealPreference|default('') ?: 'Not provided' }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">Newsletter Consent</div>
                    <p class="profile-value">{{ app.user.newsletterConsent ? 'Yes' : 'No' }}</p>
                </div>
                <div class="profile-field">
                    <div class="profile-label">Data Protection Consent</div>
                    <p class="profile-value">{{ app.user.dataProtectionConsent ? 'Yes' : 'No' }}</p>
                </div>
            </div>
        {% else %}
            <p class="eyebrow mb-2">Member Access Required</p>
            <h1 class="page-title mb-3">You are not logged in.</h1>
            <p class="lead-text">Login or register to access your summit profile and bookings.</p>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_login') }}" class="btn btn-forge">Login</a>
                <a href="{{ path('app_register') }}" class="btn btn-ghost">Register</a>
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}
