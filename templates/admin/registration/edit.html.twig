{% extends 'base.html.twig' %}

{% block title %}Edit Registration | Admin{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="talwar-card">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 mb-4">
            <div>
                <p class="eyebrow mb-2">Admin Area</p>
                <h1 class="page-title mb-3">Edit Registration</h1>
                <p class="lead-text mb-0">
                    Registration #{{ registration.id }} for {{ registration.user.email }}.
                </p>
            </div>
            <form class="align-content-start" method="post" action="{{ path('admin_registration_delete', {'id': registration.id}) }}" onsubmit="return confirm('Delete this registration?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_registration_' ~ registration.id) }}">
                <button class="btn btn-ember" type="submit">Delete</button>
            </form>
        </div>

        {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
            <div class="col-md-6">
                {{ form_row(form.summitLocation) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.status) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.mealPreference) }}
            </div>
            <div class="col-12">
                {{ form_row(form.specialNeeds) }}
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-forge btn-lg" type="submit">Save Changes</button>
                <a class="btn btn-ghost btn-lg" href="{{ path('admin_registration_index') }}">Back to Registrations</a>
            </div>
        {{ form_end(form) }}
    </section>
</main>
{% endblock %}
