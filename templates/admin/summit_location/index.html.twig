{% extends 'base.html.twig' %}

{% block title %}Summit Locations | Admin{% endblock %}

{% block body %}
<main class="auth-shell">
    <section class="talwar-card">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-4 mb-4">
            <div>
                <p class="eyebrow mb-2">Admin Area</p>
                <h1 class="page-title mb-3">Summit Locations</h1>
                <p class="lead-text mb-0">Manage the venues, cities, and dates for ISM DATA SCIENCE SUMMIT.</p>
            </div>
            <div class="d-flex align-content-start">
                <a class="btn btn-forge" href="{{ path('admin_summit_location_new') }}">Create Location</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Location</th>
                        <th>City</th>
                        <th>Capacity</th>
                        <th>Event Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for summitLocation in summitLocations %}
                        <tr>
                            <td>{{ summitLocation.locationName }}</td>
                            <td>{{ summitLocation.city }}</td>
                            <td>{{ summitLocation.capacity }}</td>
                            <td>{{ summitLocation.eventDate ? summitLocation.eventDate|date('Y-m-d H:i') : '' }}</td>
                            <td>{{ summitLocation.active ? 'Active' : 'Inactive' }}</td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
                                    <a class="btn btn-sm btn-ghost" href="{{ path('admin_summit_location_edit', {'id': summitLocation.id}) }}">Edit</a>
                                    <form method="post" action="{{ path('admin_summit_location_delete', {'id': summitLocation.id}) }}" onsubmit="return confirm('Delete this summit location?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_summit_location_' ~ summitLocation.id) }}">
                                        <button class="btn btn-sm btn-ember" type="submit">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center muted-copy py-5">No summit locations have been created yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</main>
{% endblock %}
