{{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
    <div class="col-md-6">
        {{ form_row(form.locationName) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.city) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.capacity) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.eventDate) }}
    </div>
    <div class="col-12">
        {{ form_row(form.address) }}
    </div>
    <div class="col-12">
        {{ form_row(form.isActive) }}
    </div>
    <div class="col-12 d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-forge btn-lg" type="submit">{{ button_label|default('Save') }}</button>
        <a class="btn btn-ghost btn-lg" href="{{ path('admin_summit_location_index') }}">Back to List</a>
    </div>
{{ form_end(form) }}
